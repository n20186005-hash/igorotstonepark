---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  variant?: 'overlay' | 'solid';
}
const { title, description, variant = 'solid' } = Astro.props;

const siteUrl = Astro.site;
const path = Astro.url.pathname;
const canonicalUrl = siteUrl ? new URL(path, siteUrl).toString() : undefined;
const heroPath = '/images/igorot-stone-kingdom-wide.webp';
const heroAbsolute = siteUrl ? new URL(heroPath, siteUrl).toString() : undefined;

const lastUpdated = 'Setyembre 2026';

const navLinks = [
  { href: '/', label: 'Gabay', en: 'Guide' },
  { href: '/fees/', label: 'Bayad', en: 'Fees' },
  { href: '/location/', label: 'Punta', en: 'Getting There' },
  { href: '/directory/', label: 'Directory', en: 'Directory' },
  { href: '/kasaysayan/', label: 'Kasaysayan', en: 'History & Lore' }
];
---

<!doctype html>
<html lang="fil">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#17372c" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fil_PH" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {heroAbsolute && <meta property="og:image" content={heroAbsolute} />}
    {heroAbsolute && <meta property="og:image:alt" content="Malawak na tanawin ng Igorot Stone Kingdom sa Baguio" />}
    <meta name="twitter:card" content={heroAbsolute ? 'summary_large_image' : 'summary'} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <slot name="structured-data" />

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP');
    </script>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:bg-white focus:px-4 focus:py-3">Lumaktaw sa nilalaman</a>

    <header class:list={[
      'z-40 text-white',
      variant === 'overlay'
        ? 'absolute inset-x-0 top-0 border-b border-white/15 bg-[#10271f]/55 backdrop-blur-md'
        : 'sticky top-0 border-b border-white/10 bg-[#10271f]'
    ]}>
      <div class="mx-auto flex max-w-[1440px] items-center justify-between gap-8 px-5 py-4 lg:px-10">
        <a href="/" class="flex items-center gap-3" aria-label="Igorot Stone Kingdom — umpisa">
          <img src="/favicon.svg" width="42" height="42" alt="" class="h-10 w-10" />
          <span class="leading-tight">
            <strong class="block font-serif text-[16px] tracking-wide">IGOROT STONE KINGDOM</strong>
            <span class="block text-[10px] font-semibold uppercase tracking-[0.28em] text-[#e7d8b8]">Gabay sa Baguio</span>
          </span>
        </a>
        <nav aria-label="Pangunahing nabigasyon" class="hidden items-center gap-6 text-sm font-semibold lg:flex">
          {navLinks.map((link) => (
            <a href={link.href} class="hover:text-[#e7d8b8]"><span class="lang-fil">{link.label}</span><span class="lang-en">{link.en}</span></a>
          ))}
        </nav>
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-1 text-xs font-bold" role="group" aria-label="Piliin ang wika / Select language">
            <button type="button" data-lang="fil" class="lang-switch is-active px-1" aria-pressed="true">FIL</button>
            <span class="text-white/40" aria-hidden="true">/</span>
            <button type="button" data-lang="en" class="lang-switch px-1" aria-pressed="false">EN</button>
          </div>
          <a href="https://maps.app.goo.gl/n12kgpTFurncbFv3A" target="_blank" rel="noreferrer" class="rounded-full border border-[#e7d8b8]/80 px-4 py-2 text-xs font-bold uppercase tracking-[0.14em] transition hover:bg-[#e7d8b8] hover:text-[#17372c]"><span class="lang-fil">Mapa ↗</span><span class="lang-en">Map ↗</span></a>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="bg-[#10271f] text-white">
      <div class="mx-auto grid max-w-[1440px] gap-10 px-5 py-14 lg:grid-cols-[1fr_1fr] lg:px-10">
        <div>
          <img src="/logo.svg" alt="Igorot Stone Kingdom — Gabay sa Baguio" width="360" height="96" class="h-auto w-[290px] brightness-0 invert" />
          <p class="mt-6 max-w-xl text-sm leading-6 text-white/60">Isang maikling visitor guide para sa Longlong Road, Pinsao Proper, Baguio City.</p>
        </div>
        <div class="lg:text-right">
          <p class="text-xs font-black uppercase tracking-[0.22em] text-[#dcb17c]"><span class="lang-fil">Mga pahina</span><span class="lang-en">Pages</span></p>
          <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm text-white/70 lg:justify-end">
            <a href="/" class="hover:text-white"><span class="lang-fil">Gabay</span><span class="lang-en">Guide</span></a>
            <a href="/fees/" class="hover:text-white"><span class="lang-fil">Bayad at Oras</span><span class="lang-en">Fees &amp; Hours</span></a>
            <a href="/location/" class="hover:text-white"><span class="lang-fil">Paano Pumunta</span><span class="lang-en">Getting There</span></a>
            <a href="/directory/" class="hover:text-white"><span class="lang-fil">Directory</span><span class="lang-en">Directory</span></a>
            <a href="/kasaysayan/" class="hover:text-white"><span class="lang-fil">Kasaysayan</span><span class="lang-en">History &amp; Lore</span></a>
          </div>
          <p class="mt-6 text-xs leading-6 text-white/60">Richmond Chi at Ralff Nestor Nacor · Wikimedia Commons · CC BY-SA 4.0. Ang local copies ay ni-resize at ni-compress para sa web.</p>
          <div class="mt-3 flex flex-wrap gap-4 text-xs underline decoration-white/25 underline-offset-4 lg:justify-end">
            <a href="https://commons.wikimedia.org/wiki/Category:Igorot_Stone_Kingdom" target="_blank" rel="license noreferrer">Mga source na larawan ↗</a>
            <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="license noreferrer">CC BY-SA 4.0 ↗</a>
          </div>
        </div>
      </div>
      <div class="border-t border-white/10 px-5 py-5 text-center text-xs leading-5 text-white/55 lg:px-10">Hindi ito opisyal na website ng Igorot Stone Kingdom Inc.; independent visitor guide lamang ito at maaaring magbago ang rates, oras at policies nang walang abiso rito. · <span class="lang-fil">Huling in-update: Setyembre 2026</span><span class="lang-en">Last updated: September 2026</span></div>
    </footer>

    <script is:inline>
      (function () {
        function apply(lang) {
          var en = lang === 'en';
          var root = document.documentElement;
          root.classList.toggle('lang-en', en);
          root.lang = en ? 'en' : 'fil';
          document.querySelectorAll('[data-lang]').forEach(function (b) {
            var on = b.getAttribute('data-lang') === lang;
            b.classList.toggle('is-active', on);
            b.setAttribute('aria-pressed', on ? 'true' : 'false');
          });
          try { localStorage.setItem('isk_lang', lang); } catch (e) {}
        }
        var saved = 'fil';
        try { saved = localStorage.getItem('isk_lang') || 'fil'; } catch (e) {}
        apply(saved);
        document.querySelectorAll('[data-lang]').forEach(function (b) {
          b.addEventListener('click', function () { apply(b.getAttribute('data-lang')); });
        });
      })();
    </script>

    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
  </body>
</html>
