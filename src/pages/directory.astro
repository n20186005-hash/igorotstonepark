---
import Base from '../layouts/Base.astro';
import MapsRating from '../components/MapsRating.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { directoryItems } from '../data/visit';

export const prerender = true;

const pageTitle = 'Igorot Stone Kingdom Directory: Map & Visitor Guide';
const pageDescription = 'Find the Igorot Stone Kingdom map, address, entrance fee and opening-hours guides, plus stone terraces, viewpoints and visitor information. Independent Baguio guide.';

const siteUrl = Astro.site;
const dirUrl = siteUrl ? new URL('/directory/', siteUrl).toString() : '/directory/';
const homeUrl = siteUrl ? siteUrl.toString() : '/';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Gabay', item: homeUrl },
    { '@type': 'ListItem', position: 2, name: 'Directory', item: dirUrl }
  ]
};
---
<Base title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" slot="structured-data" set:html={JSON.stringify(breadcrumb)} />

  <Breadcrumbs items={[{ fil: 'Gabay', en: 'Guide', href: '/' }, { fil: 'Directory', en: 'Directory', href: '/directory/' }]} />

  <section class="bg-[#17372c] text-white px-5 py-16 lg:px-10 lg:py-24">
    <div class="mx-auto max-w-[1440px]">
      <p class="text-xs font-black uppercase tracking-[0.24em] text-[#dcb17c]"><span class="lang-fil">Directory</span><span class="lang-en">Directory</span></p>
      <h1 class="mt-4 text-5xl font-bold leading-none md:text-6xl">Igorot Stone Kingdom Directory</h1>
      <p class="mt-6 max-w-2xl text-base leading-7 text-white/80"><span class="lang-fil">Isang mabilis na gabay sa mga bahagi ng Igorot Stone Kingdom—mula stone terraces hanggang mga viewpoint at cultural markers sa gilid ng bundok.</span><span class="lang-en">A quick guide to the parts of the Igorot Stone Kingdom—from stone terraces to viewpoint decks and cultural markers on the mountainside.</span></p>
      <p class="mt-5 max-w-2xl text-sm leading-6 text-white/65"><span class="lang-fil">Independent visitor guide ito. Para sa kasalukuyang impormasyon at mga review, <a href="https://maps.app.goo.gl/n12kgpTFurncbFv3A" target="_blank" rel="noreferrer" class="underline decoration-white/30 underline-offset-4 hover:text-white">buksan ang listing ng Igorot Stone Kingdom Inc. sa Google Maps ↗</a>.</span><span class="lang-en">This is an independent visitor guide. For current listing details and reviews, <a href="https://maps.app.goo.gl/n12kgpTFurncbFv3A" target="_blank" rel="noreferrer" class="underline decoration-white/30 underline-offset-4 hover:text-white">open Igorot Stone Kingdom Inc. on Google Maps ↗</a>.</span></p>
      <MapsRating />
    </div>
  </section>

  <div class="ridge-line" aria-hidden="true"></div>

  <section aria-labelledby="visitor-info-title" class="mx-auto max-w-[1440px] px-5 pt-12 lg:px-10">
    <h2 id="visitor-info-title" class="text-3xl font-bold text-[#17372c]"><span class="lang-fil">Mabilis na gabay sa bisita</span><span class="lang-en">Visitor information at a glance</span></h2>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      <article class="border border-[#17372c]/15 bg-[#f8f6f0] p-6">
        <h3 class="text-xl font-bold"><span class="lang-fil">Lokasyon at mapa</span><span class="lang-en">Location &amp; map</span></h3>
        <p class="mt-3 text-sm leading-6 text-[#5b625a]">Longlong Road, Pinsao Proper, Baguio, Benguet.</p>
        <a href="/location/" class="mt-4 inline-block py-2 font-semibold underline underline-offset-4"><span class="lang-fil">Mga direksyon at map pin</span><span class="lang-en">Directions &amp; map pin</span></a>
      </article>
      <article class="border border-[#17372c]/15 bg-[#f8f6f0] p-6">
        <h3 class="text-xl font-bold"><span class="lang-fil">Bayad at oras</span><span class="lang-en">Entrance fee &amp; hours</span></h3>
        <p class="mt-3 text-sm leading-6 text-[#5b625a]"><span class="lang-fil">Basahin ang gabay sa bayad at oras. Kumpirmahin sa staff ang kasalukuyang presyo at mga patakaran bago bumili.</span><span class="lang-en">Read the fee and opening-hours guide. Confirm current prices and admission rules with staff before buying tickets.</span></p>
        <a href="/fees/" class="mt-4 inline-block py-2 font-semibold underline underline-offset-4"><span class="lang-fil">Gabay sa bayad at oras</span><span class="lang-en">Fee &amp; hours guide</span></a>
      </article>
      <article class="border border-[#17372c]/15 bg-[#f8f6f0] p-6">
        <h3 class="text-xl font-bold"><span class="lang-fil">Mga tanong bago bumiyahe</span><span class="lang-en">Questions before visiting</span></h3>
        <p class="mt-3 text-sm leading-6 text-[#5b625a]"><span class="lang-fil">Alamin ang mga dapat itanong tungkol sa parking, hagdan at mobility access bago pumunta.</span><span class="lang-en">Plan ahead for parking, stairs and mobility needs, and check which areas are accessible with staff.</span></p>
        <a href="/#faq" class="mt-4 inline-block py-2 font-semibold underline underline-offset-4"><span class="lang-fil">Mga madalas itanong</span><span class="lang-en">Visitor FAQ</span></a>
      </article>
    </div>
  </section>

  <section class="mx-auto max-w-[1440px] px-5 py-16 lg:px-10 lg:py-24">
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
      {directoryItems.map((item, index) => (
        <article class:list={['border border-[#17372c]/15 p-8', index % 2 === 0 ? 'bg-[#f8f6f0]' : 'bg-[#f2ede1]']}>
          <div class="flex flex-wrap items-center justify-between gap-4">
            <h2 class="font-serif text-2xl font-bold text-[#17372c]">{item.name}</h2>
            <span class="w-fit border border-[#17372c]/20 px-3 py-1.5 text-[10px] font-black uppercase tracking-[0.15em] text-[#405045]">{item.tag}</span>
          </div>
          <p class="mt-4 text-sm leading-6 text-[#5b625a]">{item.note}</p>
        </article>
      ))}
    </div>
    <p class="mt-10 max-w-3xl text-sm leading-6 text-[#596158]">Ang Igorot Stone Kingdom ay isang modernong cultural theme attraction na humuhugot ng inspirasyon sa stonework at kuwentong Cordilleran—hindi sinaunang archaeological ruin. Ang layout ay tuloy-tuloy na hagdan at stone passages, kaya hindi ideal para sa wheelchair o stroller.</p>
    <a href="/location/" class="mt-8 inline-flex items-center gap-2 text-sm font-black uppercase tracking-[0.12em] text-[#17372c] hover:text-[#a85f3d]">Paano pumunta ↗</a>
  </section>
</Base>
