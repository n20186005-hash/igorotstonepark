---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { feeTiers, feeFaqs } from '../data/visit';

export const prerender = true;

const pageTitle = 'Igorot Stone Kingdom Entrance Fee & Opening Hours — Baguio';
const pageDescription = 'Igorot Stone Kingdom entrance fee: ~₱130 adult, ~₱100 child, free for toddlers. Opening hours 7 AM–6 PM daily, parking, payment tips and visitor FAQ.';

const siteUrl = Astro.site;
const feesUrl = siteUrl ? new URL('/fees/', siteUrl).toString() : '/fees/';
const homeUrl = siteUrl ? siteUrl.toString() : '/';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Gabay', item: homeUrl },
    { '@type': 'ListItem', position: 2, name: 'Bayad at Oras', item: feesUrl }
  ]
};

const faqStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: feeFaqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer }
  }))
};
---
<Base title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" slot="structured-data" set:html={JSON.stringify(breadcrumb)} />
  <script type="application/ld+json" slot="structured-data" set:html={JSON.stringify(faqStructuredData)} />

  <Breadcrumbs items={[{ fil: 'Gabay', en: 'Guide', href: '/' }, { fil: 'Bayad at Oras', en: 'Fees & Hours', href: '/fees/' }]} />

  <section class="bg-[#17372c] text-white px-5 py-16 lg:px-10 lg:py-24">
    <div class="mx-auto max-w-[1440px]">
      <p class="text-xs font-black uppercase tracking-[0.24em] text-[#dcb17c]"><span class="lang-fil">Bayad at Oras</span><span class="lang-en">Fees &amp; Hours</span></p>
      <h1 class="mt-4 text-5xl font-bold leading-none md:text-6xl"><span class="lang-fil">Entrance Fee &amp; Opening Hours</span><span class="lang-en">Entrance Fee &amp; Opening Hours</span></h1>
      <p class="mt-6 max-w-2xl text-base leading-7 text-white/80"><span class="lang-fil">Praktikal na detalye bago umakyat sa Igorot Stone Kingdom sa Baguio: admission, oras, parking at mga tip sa pagbabayad.</span><span class="lang-en">Practical details before climbing the Igorot Stone Kingdom in Baguio: admission, hours, parking and payment tips.</span></p>
      <p class="mt-5 max-w-2xl text-sm leading-6 text-white/65"><span class="lang-fil">Rating: 4.4 ★ (5,411 reviews) sa Google Maps — <a href="https://maps.app.goo.gl/n12kgpTFurncbFv3A" target="_blank" rel="noreferrer" class="underline decoration-white/30 underline-offset-4 hover:text-white">tingnan ang lahat ng review ↗</a></span><span class="lang-en">Rating: 4.4 ★ (5,411 reviews) on Google Maps — <a href="https://maps.app.goo.gl/n12kgpTFurncbFv3A" target="_blank" rel="noreferrer" class="underline decoration-white/30 underline-offset-4 hover:text-white">view all reviews ↗</a></span></p>
    </div>
  </section>

  <div class="ridge-line" aria-hidden="true"></div>

  <section class="mx-auto max-w-[1440px] px-5 py-16 lg:px-10 lg:py-24">
    <div class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:gap-16">
      <div>
        <p class="text-xs font-black uppercase tracking-[0.24em] text-[#a85f3d]">Admission</p>
        <h2 class="mt-4 text-4xl font-bold leading-none md:text-5xl">Entrance fee</h2>
        <div class="mt-9 grid gap-3 sm:grid-cols-3">
          {feeTiers.map((tier) => (
            <div class="stone-texture stone-edge p-6">
              <span class="text-xs font-black uppercase tracking-wider text-[#4c5a50]">{tier.label}</span>
              <strong class="mt-2 block font-serif text-4xl text-[#17372c]">{tier.price}</strong>
            </div>
          ))}
        </div>
        <p class="mt-5 text-sm leading-6 text-[#5b625a]">*Ito ang mga pinakahuling madalas na iniulat na admission figures. Discount categories, promos at age rules ay maaaring magbago; kumpirmahin ang eksaktong rate sa entrance.</p>
        <a href="/location/" class="mt-8 inline-flex items-center gap-2 text-sm font-black uppercase tracking-[0.12em] text-[#17372c] hover:text-[#a85f3d]">Paano pumunta ↗</a>
      </div>

      <div class="border-l-4 border-[#a85f3d] bg-[#17372c] p-8 text-white md:p-11">
        <p class="text-xs font-black uppercase tracking-[0.24em] text-[#dcb17c]">Opening hours</p>
        <h3 class="mt-3 text-4xl font-bold">7:00 AM – 6:00 PM</h3>
        <p class="mt-4 text-sm leading-6 text-white/75">Araw-araw, pero maaaring magbago sa espesyal na okasyon o kapag maulan. Maglaan ng 1–2 oras para sa pangunahing ruta.</p>
        <ul class="mt-6 space-y-3 text-sm text-white/85">
          <li class="flex gap-3"><span class="text-[#dcb17c]">◆</span><span>Weekday at maagang umaga ang pinakatahimik.</span></li>
          <li class="flex gap-3"><span class="text-[#dcb17c]">◆</span><span>Parking ay humigit-kumulang ₱100 sa ilang area; magdala ng cash.</span></li>
          <li class="flex gap-3"><span class="text-[#dcb17c]">◆</span><span>Kumpirmahin sa gate o Google Maps listing para sa same-day.</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-[#efe8da] py-16 lg:py-24">
    <div class="mx-auto max-w-[1200px] px-5 lg:px-10">
      <p class="text-xs font-black uppercase tracking-[0.24em] text-[#a85f3d]">FAQ · Bayad at Oras</p>
      <h2 class="mt-4 text-5xl font-bold leading-none md:text-6xl">Bago ka bumili ng ticket.</h2>
      <div class="mt-12 border-t border-[#17372c]/20">
        {feeFaqs.map((faq) => (
          <details class="faq-item group border-b border-[#17372c]/20 py-1">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-left text-xl font-bold text-[#17372c] marker:hidden md:text-2xl">
              <span>{faq.question}</span>
              <span class="faq-plus shrink-0 text-3xl font-light text-[#a85f3d] transition-transform">+</span>
            </summary>
            <p class="max-w-3xl pb-7 pr-10 text-sm leading-7 text-[#596158]">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>
