---
import Base from '../layouts/Base.astro';
import WeatherModule from '../components/WeatherModule.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { transportModes } from '../data/visit';

export const prerender = true;

const pageTitle = 'Igorot Stone Kingdom Location & How to Get There — Baguio';
const pageDescription = 'How to get to Igorot Stone Kingdom in Baguio: taxi, jeepney (Tam-awan/Longlong route), from Loakan Airport, or driving to 362 Longlong Road, Pinsao Proper. Map and coordinates.';

const siteUrl = Astro.site;
const locUrl = siteUrl ? new URL('/location/', siteUrl).toString() : '/location/';
const homeUrl = siteUrl ? siteUrl.toString() : '/';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Gabay', item: homeUrl },
    { '@type': 'ListItem', position: 2, name: 'Paano Pumunta', item: locUrl }
  ]
};
---
<Base title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" slot="structured-data" set:html={JSON.stringify(breadcrumb)} />

  <Breadcrumbs items={[{ fil: 'Gabay', en: 'Guide', href: '/' }, { fil: 'Paano Pumunta', en: 'Getting There', href: '/location/' }]} />

  <section class="bg-[#17372c] text-white px-5 py-16 lg:px-10 lg:py-24">
    <div class="mx-auto max-w-[1440px]">
      <p class="text-xs font-black uppercase tracking-[0.24em] text-[#dcb17c]"><span class="lang-fil">Paano Pumunta</span><span class="lang-en">Getting There</span></p>
      <h1 class="mt-4 text-5xl font-bold leading-none md:text-6xl"><span class="lang-fil">Location &amp; Directions</span><span class="lang-en">Location &amp; Directions</span></h1>
      <p class="mt-6 max-w-2xl text-base leading-7 text-white/80"><span class="lang-fil">Address: <strong>362 Longlong Road, Pinsao Proper, Baguio City, 2600 Benguet</strong>. Narito ang mga paraan para makarating mula sa sentro at paliparan.</span><span class="lang-en">Address: <strong>362 Longlong Road, Pinsao Proper, Baguio City, 2600 Benguet</strong>. Here are the ways to get there from the center and the airport.</span></p>
      <p class="mt-5 max-w-2xl text-sm leading-6 text-white/65"><span class="lang-fil">Rating: 4.4 ★ (5,411 reviews) sa Google Maps — <a href="https://maps.app.goo.gl/n12kgpTFurncbFv3A" target="_blank" rel="noreferrer" class="underline decoration-white/30 underline-offset-4 hover:text-white">tingnan ang lahat ng review ↗</a></span><span class="lang-en">Rating: 4.4 ★ (5,411 reviews) on Google Maps — <a href="https://maps.app.goo.gl/n12kgpTFurncbFv3A" target="_blank" rel="noreferrer" class="underline decoration-white/30 underline-offset-4 hover:text-white">view all reviews ↗</a></span></p>
    </div>
  </section>

  <div class="ridge-line" aria-hidden="true"></div>

  <WeatherModule />

  <section class="mx-auto max-w-[1440px] px-5 py-16 lg:px-10 lg:py-24">
    <div class="space-y-4">
      {transportModes.map((mode) => (
        <article class="grid gap-4 border-t border-[#17372c]/20 py-6 md:grid-cols-[160px_1fr]">
          <p class="text-xs font-black uppercase tracking-[0.18em] text-[#a85f3d]">{mode.label}</p>
          <div>
            <h2 class="text-2xl font-bold text-[#17372c]">{mode.title}</h2>
            <p class="mt-2 text-sm leading-6 text-[#5b625a]">{mode.note}</p>
            {mode.extra && (
              <ul class="mt-4 space-y-2 text-sm leading-6 text-[#5b625a]">
                {mode.extra.map((item) => (
                  <li class="flex gap-3"><span class="shrink-0 text-[#a85f3d]">◆</span><span>{item}</span></li>
                ))}
              </ul>
            )}
          </div>
        </article>
      ))}
    </div>

    <div class="mt-14 grid gap-7 lg:grid-cols-[1.35fr_.65fr] lg:items-stretch">
      <div class="map-frame overflow-hidden border-2 border-[#17372c] bg-white">
        <iframe
          title="Mapa ng Igorot Stone Kingdom sa Baguio"
          src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d6816.607439247363!2d120.5725104!3d16.4315628!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3391a3e931948e1f%3A0x992084ab1a61b3ff!2sIgorot%20Stone%20Kingdom%20Inc.!5e1!3m2!1szh-CN!2s!4v1786412902432!5m2!1szh-CN!2s"
          width="100%"
          height="520"
          style="border:0; display:block;"
          loading="lazy"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"></iframe>
      </div>
      <div class="stone-texture stone-edge flex flex-col justify-between p-8 md:p-10">
        <div>
          <p class="text-xs font-black uppercase tracking-[0.22em] text-[#a85f3d]">Coordinates</p>
          <p class="mt-3 font-serif text-3xl font-bold text-[#17372c]">16.4315628,<br />120.5750853</p>
          <p class="mt-6 text-sm leading-6 text-[#515951]">I-save ang pin bago bumiyahe. Kapag mahina ang signal sa uphill streets, may reference ka pa rin sa eksaktong lokasyon.</p>
        </div>
        <a href="https://maps.app.goo.gl/n12kgpTFurncbFv3A" target="_blank" rel="noreferrer" class="mt-9 inline-flex items-center justify-between border-t border-[#17372c]/25 pt-5 text-sm font-black uppercase tracking-[0.12em] text-[#17372c]">Buksan sa Google Maps <span>↗</span></a>
      </div>
    </div>
  </section>
</Base>
