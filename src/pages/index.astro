---
import Base from '../layouts/Base.astro';
import WeatherModule from '../components/WeatherModule.astro';
import { faqs, foodSpots, nearbyPlaces, visitFacts, facilities, quarterStrategy, crowdRoutes, generalRoutes, aboutContext } from '../data/visit';

export const prerender = true;

const siteUrl = Astro.site;
const path = Astro.url.pathname;
const canonicalUrl = siteUrl ? new URL(path, siteUrl).toString() : undefined;
const heroPath = '/images/igorot-stone-kingdom-wide.webp';
const heroAbsolute = siteUrl ? new URL(heroPath, siteUrl).toString() : undefined;
const pageTitle = 'Igorot Stone Kingdom Baguio — Entrance Fee, Hours & Directory';
const pageDescription = 'Visit Igorot Stone Kingdom in Baguio: real-time weather, entrance fee, opening hours, location & directions, parking, transport, facilities, food spots, nearby places and FAQ.';

const mapsShareUrl = 'https://maps.app.goo.gl/n12kgpTFurncbFv3A';
const govtTourismUrl = 'https://www.tourism.gov.ph';

const attractionId = canonicalUrl ? `${canonicalUrl}#attraction` : '#attraction';
const attractionStructuredData = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LocalBusiness'],
  '@id': attractionId,
  name: 'Igorot Stone Kingdom Inc.',
  alternateName: ['Igorot Stone Kingdom', 'Igorot Stone Kingdom Baguio'],
  description: 'Isang modernong hillside cultural theme attraction sa Baguio na kilala sa malalaking stone terraces, passages at Cordillera-inspired storytelling.',
  url: canonicalUrl || 'https://igorotstonepark.com',
  image: heroAbsolute ? [heroAbsolute] : undefined,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '362 Longlong Road, Pinsao Proper',
    addressLocality: 'Baguio',
    addressRegion: 'Benguet',
    postalCode: '2600',
    addressCountry: 'PH'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 16.4315628,
    longitude: 120.5750853
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '07:00',
      closes: '18:00'
    }
  ],
  priceRange: '₱₱',
  hasMap: mapsShareUrl,
  sameAs: [mapsShareUrl, govtTourismUrl]
};

const faqStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer
    }
  }))
};
---

<Base title={pageTitle} description={pageDescription} variant="overlay">
  <script type="application/ld+json" slot="structured-data" set:html={JSON.stringify(attractionStructuredData)} />
  <script type="application/ld+json" slot="structured-data" set:html={JSON.stringify(faqStructuredData)} />

  <section id="top" class="hero-photo relative min-h-[790px] overflow-hidden bg-[#17372c] text-white">
    <img src={heroPath} alt="Malawak na tanawin ng mga stone terrace at tore ng Igorot Stone Kingdom" class="absolute inset-0 h-full w-full object-cover" fetchpriority="high" />
    <div class="relative z-10 mx-auto grid min-h-[790px] max-w-[1440px] items-end gap-10 px-5 pb-14 pt-32 lg:grid-cols-[1.35fr_.65fr] lg:px-10 lg:pb-20">
      <div class="max-w-[900px]">
        <div class="mb-7 flex flex-wrap items-center gap-3 text-[11px] font-black uppercase tracking-[0.24em]">
          <span class="bg-[#a85f3d] px-4 py-2">Pinsao Proper</span>
          <span class="border border-white/45 px-4 py-2">Baguio City · Cordillera</span>
        </div>
        <p class="mb-4 font-serif text-xl italic text-[#eadfca] md:text-2xl"><span class="lang-fil">Bato, ulap, hagdan at tanawing bundok.</span><span class="lang-en">Stone, cloud, stairs and mountain views.</span></p>
        <h1 class="max-w-[880px] text-[clamp(4rem,9vw,8.7rem)] font-bold leading-[.8] tracking-[-0.055em]">Igorot<br />Stone Kingdom</h1>
        <p class="mt-8 max-w-2xl text-base leading-7 text-white/84 md:text-lg"><span class="lang-fil">Ang Igorot Stone Kingdom Inc. (kilala rin bilang Igorot Stone Kingdom), sa Baguio, Benguet, Philippines, ay isang modernong hillside attraction na hinubog sa malalaking stone terrace at Cordillera-inspired na kuwento—gabay ito para maayos mong maplano ang pagbisita, mula bayad at parking hanggang kainan sa paligid.</span><span class="lang-en">Igorot Stone Kingdom Inc. (also known as Igorot Stone Kingdom), in Baguio, Benguet, Philippines, is a modern hillside attraction shaped from large stone terraces and Cordillera-inspired storytelling—a guide to planning your visit, from fees and parking to food nearby.</span></p>
        <p class="mt-4 text-sm text-white/65">Igorot Stone Kingdom Inc. · Baguio, Benguet, Philippines</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#plano" class="bg-[#e7d8b8] px-6 py-3.5 text-sm font-black uppercase tracking-[0.12em] text-[#17372c] transition hover:bg-white"><span class="lang-fil">Planuhin ang bisita</span><span class="lang-en">Plan your visit</span></a>
          <a href="#pagpunta" class="border border-white/55 bg-white/5 px-6 py-3.5 text-sm font-black uppercase tracking-[0.12em] text-white backdrop-blur transition hover:bg-white/15"><span class="lang-fil">Paano pumunta</span><span class="lang-en">Getting there</span></a>
        </div>
      </div>

      <aside class="stone-texture stone-edge ml-auto w-full max-w-[380px] p-7 text-[#20261f] shadow-2xl md:p-9">
        <p class="text-[11px] font-black uppercase tracking-[0.23em] text-[#a85f3d]">Mabilis na tingin</p>
        <div class="mt-5 grid grid-cols-2 gap-x-6 gap-y-6">
          <div><span class="block text-xs font-bold uppercase tracking-wider text-[#375143]"><span class="lang-fil">Oras</span><span class="lang-en">Hours</span></span><strong class="mt-1 block font-serif text-2xl">7 AM–6 PM</strong></div>
          <div><span class="block text-xs font-bold uppercase tracking-wider text-[#375143]"><span class="lang-fil">Tagal</span><span class="lang-en">Duration</span></span><strong class="mt-1 block font-serif text-2xl">1–2 oras</strong></div>
          <div><span class="block text-xs font-bold uppercase tracking-wider text-[#375143]"><span class="lang-fil">Adult</span><span class="lang-en">Adult</span></span><strong class="mt-1 block font-serif text-2xl">~₱130</strong></div>
          <div><span class="block text-xs font-bold uppercase tracking-wider text-[#375143]"><span class="lang-fil">Rating</span><span class="lang-en">Rating</span></span><strong class="mt-1 block font-serif text-2xl">4.4 ★</strong><span class="mt-1 block text-xs text-[#5b625a]">5,411 reviews</span><span class="mt-1 block text-[10px] leading-4 text-[#7a827a]"><span class="lang-fil">Mula sa Google Maps · Setyembre 2026</span><span class="lang-en">From Google Maps · Sep 2026</span></span></div>
        </div>
        <p class="mt-7 border-t border-[#17372c]/20 pt-5 text-xs leading-5 text-[#4f574e]">Rates at oras ay maaaring magbago. Para sa same-day visit, kumpirmahin sa gate o sa kasalukuyang Google Maps listing.</p>
      </aside>
    </div>
  </section>

  <div class="ridge-line" aria-hidden="true"></div>

  <section id="plano" class="mx-auto max-w-[1440px] px-5 py-20 lg:px-10 lg:py-28">
    <div class="grid gap-12 lg:grid-cols-[.72fr_1.28fr] lg:gap-20">
      <div>
        <p class="text-xs font-black uppercase tracking-[0.24em] text-[#a85f3d]"><span class="lang-fil">Bago umakyat</span><span class="lang-en">Before you climb</span></p>
        <h2 class="mt-4 text-5xl font-bold leading-[.95] tracking-tight md:text-6xl"><span class="lang-fil">Alamin muna ang ritmo ng lugar.</span><span class="lang-en">Learn the rhythm of the place first.</span></h2>
        <p class="mt-7 max-w-lg text-base leading-7 text-[#4d554d]">Hindi ito flat na park. Ang experience ay tuloy-tuloy na hagdan, pasikot-sikot na stone passages, viewpoint at photo stops. Kumportableng sapatos at kaunting pacing ang malaking tulong.</p>
      </div>
      <div class="grid gap-px overflow-hidden border border-[#17372c]/15 bg-[#17372c]/15 sm:grid-cols-2">
        {visitFacts.map((fact, index) => (
          <article class:list={['min-h-[190px] bg-[#f7f5ef] p-7 md:p-9', index === 0 || index === 3 ? 'stone-grid' : '']}>
            <p class="text-[11px] font-black uppercase tracking-[0.2em] text-[#a85f3d]">{fact.label}</p>
            <p class="mt-4 font-serif text-3xl font-bold leading-tight text-[#17372c]">{fact.value}</p>
            {fact.note && <p class="mt-3 max-w-sm text-sm leading-6 text-[#5b625a]">{fact.note}</p>}
          </article>
        ))}
      </div>
    </div>

    <div class="mt-16 grid overflow-hidden bg-[#17372c] text-white lg:grid-cols-[1fr_1.2fr]">
      <div class="p-8 md:p-12 lg:p-14">
        <p class="text-xs font-black uppercase tracking-[0.24em] text-[#dcb17c]">Mahalagang konteksto</p>
        <h3 class="mt-4 text-4xl font-bold leading-tight md:text-5xl">Modernong interpretasyon, hindi sinaunang guho.</h3>
        <p class="mt-6 max-w-xl leading-7 text-white/78">Ang Igorot Stone Kingdom ay isang modernong attraction na humuhugot ng inspirasyon sa stonework at kuwentong Cordilleran. Mas makabuluhang bumisita kapag kinikilala itong malikhaing interpretasyon—hindi kapalit ng mga buhay, magkakaiba at patuloy na tradisyon ng mga komunidad sa Cordillera.</p>
      </div>
      <img src="/images/igorot-stone-kingdom-terraces.webp" alt="Stone terraces ng Igorot Stone Kingdom sa gilid ng luntiang bundok" loading="lazy" class="h-full min-h-[390px] w-full object-cover" />
    </div>
  </section>

  <section class="bg-[#e1d2b5] py-20 lg:py-24" aria-labelledby="gallery-title">
    <div class="mx-auto max-w-[1440px] px-5 lg:px-10">
      <div class="mb-10 flex flex-col justify-between gap-5 md:flex-row md:items-end">
        <div>
          <p class="text-xs font-black uppercase tracking-[0.24em] text-[#a85f3d]"><span class="lang-fil">Sa loob</span><span class="lang-en">Inside</span></p>
          <h2 id="gallery-title" class="mt-3 text-5xl font-bold tracking-tight text-[#17372c]"><span class="lang-fil">Bato sa bawat antas.</span><span class="lang-en">Stone at every level.</span></h2>
        </div>
        <p class="max-w-lg text-sm leading-6 text-[#4d554d]">Mga totoong larawan ng attraction; naka-save sa project mismo para walang hotlink sa production.</p>
      </div>
      <a href="/directory/" class="mt-5 inline-flex items-center gap-2 text-sm font-black uppercase tracking-[0.12em] text-[#17372c] hover:text-[#a85f3d]"><span class="lang-fil">Tignan ang park directory →</span><span class="lang-en">See the park directory →</span></a>
      <div class="mt-6 grid gap-4 lg:grid-cols-[1.25fr_.75fr]">
        <figure class="group overflow-hidden bg-[#17372c]">
          <img src="/images/igorot-stone-kingdom-stonework.webp" alt="Mataas na tanawin sa maraming antas ng stone terraces" loading="lazy" class="h-[430px] w-full object-cover transition duration-500 group-hover:scale-[1.02] md:h-[620px]" />
          <figcaption class="bg-[#17372c] px-5 py-4 text-sm leading-6 text-white/80"><span class="lang-fil"><strong>Sining ng bato:</strong> ang bawat antas ay pinagtagpi-tagping bato nang walang semento—isang pamamaraang humuhugot sa dry-stone walling ng Cordillera.</span><span class="lang-en"><strong>The craft of stone:</strong> each tier is fitted stone without mortar—a method inspired by Cordillera dry-stone walling.</span></figcaption>
        </figure>
        <div class="grid gap-4">
          <figure class="overflow-hidden bg-[#17372c]">
            <img src="/images/igorot-stone-kingdom-wide.webp" alt="Malawak na view ng stone structures at courtyard" loading="lazy" class="h-[300px] w-full object-cover md:h-[302px]" />
            <figcaption class="bg-[#17372c] px-5 py-4 text-sm leading-6 text-white/80"><span class="lang-fil"><strong>Centro at courtyard:</strong> dito nagtatapos ang hagdan mula sa gate—ang pinakamadaling assembly point bago akyatin ang mga terrace.</span><span class="lang-en"><strong>Center &amp; courtyard:</strong> where the stairs from the gate end—the easiest assembly point before climbing the terraces.</span></figcaption>
          </figure>
          <figure class="overflow-hidden bg-[#17372c]">
            <img src="/images/igorot-stone-kingdom-marker.webp" alt="Opisyal na information marker ng Igorot Stone Kingdom" loading="lazy" class="h-[300px] w-full object-cover object-center md:h-[302px]" />
            <figcaption class="bg-[#17372c] px-5 py-4 text-sm leading-6 text-white/80"><span class="lang-fil"><strong>Information marker:</strong> naglalaman ng opisyal na pangalan at pointer para sa mga bisita; maganda ring photo stop.</span><span class="lang-en"><strong>Information marker:</strong> shows the official name and pointers for visitors; also a good photo stop.</span></figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <section id="bayad" class="mx-auto max-w-[1440px] px-5 py-20 lg:px-10 lg:py-28">
    <div class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:gap-16">
      <div>
        <p class="text-xs font-black uppercase tracking-[0.24em] text-[#a85f3d]"><span class="lang-fil">Bayad / Gastos</span><span class="lang-en">Fees / Costs</span></p>
        <h2 class="mt-4 text-5xl font-bold leading-none md:text-6xl"><span class="lang-fil">Maghanda ng cash at kaunting allowance.</span><span class="lang-en">Bring cash and a little allowance.</span></h2>
        <div class="mt-9 grid gap-3 sm:grid-cols-3">
          <div class="stone-texture stone-edge p-6"><span class="text-xs font-black uppercase tracking-wider text-[#4c5a50]">Adult</span><strong class="mt-2 block font-serif text-4xl text-[#17372c]">~₱130</strong></div>
          <div class="stone-texture stone-edge p-6"><span class="text-xs font-black uppercase tracking-wider text-[#4c5a50]">Bata</span><strong class="mt-2 block font-serif text-4xl text-[#17372c]">~₱100</strong></div>
          <div class="stone-texture stone-edge p-6"><span class="text-xs font-black uppercase tracking-wider text-[#4c5a50]">Toddler</span><strong class="mt-2 block font-serif text-4xl text-[#17372c]">Libre*</strong></div>
        </div>
        <p class="mt-5 text-sm leading-6 text-[#5b625a]">*Ito ang mga pinakahuling madalas na iniulat na admission figures. Discount categories, promos at age rules ay maaaring magbago; kumpirmahin ang eksaktong rate sa entrance.</p>
        <a href="/fees/" class="mt-6 inline-flex items-center gap-2 text-sm font-black uppercase tracking-[0.12em] text-[#17372c] hover:text-[#a85f3d]"><span class="lang-fil">Buong gabay sa bayad at oras →</span><span class="lang-en">Full fee &amp; hours guide →</span></a>
      </div>

      <div id="parking" class="border-l-4 border-[#a85f3d] bg-[#17372c] p-8 text-white md:p-11">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-xs font-black uppercase tracking-[0.24em] text-[#dcb17c]">Parking</p>
            <h3 class="mt-3 text-4xl font-bold">Maaga = mas kaunting abala.</h3>
          </div>
          <span class="text-4xl" aria-hidden="true">P</span>
        </div>
        <p class="mt-6 leading-7 text-white/78">May mga parking area sa paligid ng attraction, pero mabilis mapuno sa weekend at peak hours. May ilang recent visitor reports na humigit-kumulang ₱100 ang car parking; huwag ituring na fixed rate dahil maaaring mag-iba ang operator at araw.</p>
        <ul class="mt-7 space-y-3 text-sm text-white/85">
          <li class="flex gap-3"><span class="text-[#dcb17c]">◆</span><span>Dumating malapit sa opening time kung may sariling sasakyan.</span></li>
          <li class="flex gap-3"><span class="text-[#dcb17c]">◆</span><span>Magdala ng maliit na cash para sa parking at incidental fees.</span></li>
          <li class="flex gap-3"><span class="text-[#dcb17c]">◆</span><span>Kung ayaw sa parking stress, taxi ang pinakasimple mula sa city center.</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-[#17372c] py-20 text-white lg:py-28" aria-labelledby="best-time-title">
    <div class="mx-auto grid max-w-[1440px] gap-10 px-5 lg:grid-cols-[.7fr_1.3fr] lg:px-10">
      <div>
        <p class="text-xs font-black uppercase tracking-[0.24em] text-[#dcb17c]"><span class="lang-fil">Pinakamagandang oras</span><span class="lang-en">Best time to go</span></p>
        <h2 id="best-time-title" class="mt-4 text-5xl font-bold leading-none md:text-6xl"><span class="lang-fil">Weekday.<br />Maagang umaga.</span><span class="lang-en">Weekday.<br />Early morning.</span></h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <article class="border border-white/15 bg-white/5 p-7">
          <span class="font-serif text-5xl text-[#dcb17c]">01</span>
          <h3 class="mt-5 text-2xl font-bold">Para sa mas tahimik na lakad</h3>
          <p class="mt-3 text-sm leading-6 text-white/70">Weekday morning ang mas komportable para sa viewpoints, makikitid na passage at mga litrato na hindi masyadong siksikan.</p>
        </article>
        <article class="border border-white/15 bg-white/5 p-7">
          <span class="font-serif text-5xl text-[#dcb17c]">02</span>
          <h3 class="mt-5 text-2xl font-bold">Maglaan ng 1–2 oras</h3>
          <p class="mt-3 text-sm leading-6 text-white/70">Sapat para sa pangunahing ruta. Dagdagan kung mabagal ang pace, maraming photo stops o may kasamang bata at senior.</p>
        </article>
        <article class="border border-white/15 bg-white/5 p-7 sm:col-span-2">
          <span class="font-serif text-5xl text-[#dcb17c]">03</span>
          <h3 class="mt-5 text-2xl font-bold">Baguio weather: laging may plan B.</h3>
          <p class="mt-3 max-w-2xl text-sm leading-6 text-white/70">Madaling magpalit ang araw, ulap at ambon. Lightweight rain layer, sapatos na may kapit at tubig ang mas praktikal kaysa sobrang daming gamit.</p>
        </article>
      </div>
    </div>
  </section>

  <WeatherModule />

  <section id="estrategiya" class="bg-[#efe8da] py-20 lg:py-28" aria-labelledby="quarter-title">
    <div class="mx-auto max-w-[1440px] px-5 lg:px-10">
      <div class="mb-10 max-w-2xl">
        <p class="text-xs font-black uppercase tracking-[0.24em] text-[#a85f3d]"><span class="lang-fil">Estratehiya kada panahon</span><span class="lang-en">Strategy by season</span></p>
        <h2 id="quarter-title" class="mt-3 text-5xl font-bold tracking-tight text-[#17372c]"><span class="lang-fil">Kailan ka dapat pumunta?</span><span class="lang-en">When should you visit?</span></h2>
        <p class="mt-5 text-sm leading-6 text-[#596158]">Batay sa karaniwang klima ng Baguio (cool highland, may tag-araw at tag-ulan). Ang kondisyon ay nag-iiba-iba taon-taon, kaya ituring ito bilang gabay, hindi katiyakan.</p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[680px] border-collapse text-left">
          <thead>
            <tr class="border-b-2 border-[#17372c]/30 text-xs font-black uppercase tracking-[0.14em] text-[#375143]">
              <th class="py-4 pr-6">Quarter</th>
              <th class="py-4 pr-6">Panahon</th>
              <th class="py-4 pr-6">Gaan sa paglakad</th>
              <th class="py-4">Payo</th>
            </tr>
          </thead>
          <tbody class="text-sm">
            {quarterStrategy.map((q) => (
              <tr class="border-b border-[#17372c]/15 align-top">
                <td class="py-5 pr-6 font-bold text-[#17372c]">{q.quarter}</td>
                <td class="py-5 pr-6 text-[#5b625a]">{q.weather}</td>
                <td class="py-5 pr-6 text-[#5b625a]">{q.comfort}</td>
                <td class="py-5 text-[#5b625a]">{q.tip}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-8 max-w-3xl text-xs leading-6 text-[#7a827a]">
        <span class="lang-fil"><strong>Pagtitipid at pamamaraan:</strong> ang mga rekomendasyong pana-panahon ay batay sa pangkaraniwang klima ng Baguio (cool highland, may tag-araw at tag-ulan) at hindi eksaktong forecast. Ang live na datos ng panahon ay kinukuha nang server-side at naka-cache nang humigit-kumulang 30 minuto upang maging sariwa nang hindi masyadong madalas humingi sa data source. Gabay lamang ito, hindi katiyakan.</span>
        <span class="lang-en"><strong>Data &amp; method:</strong> the seasonal recommendations are based on Baguio’s typical highland climate (cool, with wet and dry seasons) and are not an exact forecast. Live weather is fetched server-side and cached for about 30 minutes so it stays fresh without over-requesting the data source. Guidance only, not a guarantee.</span>
      </p>
    </div>
  </section>

  <section id="ruta" class="mx-auto max-w-[1440px] px-5 py-20 lg:px-10 lg:py-28" aria-labelledby="ruta-title">
    <div class="mb-12 max-w-2xl">
      <p class="text-xs font-black uppercase tracking-[0.24em] text-[#a85f3d]"><span class="lang-fil">Paano i-enjoy</span><span class="lang-en">How to enjoy it</span></p>
      <h2 id="ruta-title" class="mt-3 text-5xl font-bold tracking-tight text-[#17372c]"><span class="lang-fil">Ruta para sa iba’t ibang bisita.</span><span class="lang-en">Routes for different visitors.</span></h2>
      <p class="mt-5 text-sm leading-6 text-[#596158]">Piliin ayon sa iyong kasama at pace. Lahat ay nasa parehong hillside attraction, kaya i-adjust ang intensity kung kinakailangan.</p>
      <button type="button" class="no-print mt-6 inline-flex items-center gap-2 rounded-full border border-[#17372c] px-5 py-2.5 text-xs font-black uppercase tracking-[0.12em] text-[#17372c] transition hover:bg-[#17372c] hover:text-white" onclick="window.print()"><span class="lang-fil">🖨️ I-print ang itinerary</span><span class="lang-en">🖨️ Print itinerary</span></button>
    </div>

    <h3 class="mb-5 text-xs font-black uppercase tracking-[0.2em] text-[#a85f3d]">Ayon sa grupo</h3>
    <div class="grid gap-4 lg:grid-cols-3">
      {crowdRoutes.map((r) => (
        <article class="border border-[#17372c]/15 bg-[#f8f6f0] p-8">
          <div class="flex items-center gap-3">
            <span class="text-3xl" aria-hidden="true">{r.icon}</span>
            <div>
              <h4 class="font-serif text-2xl font-bold text-[#17372c]">{r.title}</h4>
              <p class="text-xs text-[#7a827a]">{r.who}</p>
            </div>
          </div>
          <ol class="mt-6 space-y-3 text-sm leading-6 text-[#5b625a]">
            {r.steps.map((s) => (
              <li class="flex gap-3"><span class="shrink-0 font-bold text-[#a85f3d]">◆</span><span>{s}</span></li>
            ))}
          </ol>
        </article>
      ))}
    </div>

    <h3 class="mb-5 mt-14 text-xs font-black uppercase tracking-[0.2em] text-[#a85f3d]">Karaniwang ruta</h3>
