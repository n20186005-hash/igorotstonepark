---
import Base from '../layouts/Base.astro';
import MapsRating from '../components/MapsRating.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { topics, type Topic } from '../data/topics';

interface Props {
  topic: Topic;
}
const { topic } = Astro.props;

const siteUrl = Astro.site;
const pageUrl = siteUrl ? new URL(`/${topic.slug}/`, siteUrl).toString() : `/${topic.slug}/`;
const homeUrl = siteUrl ? siteUrl.toString() : '/';

const groupLabels: Record<Topic['group'], { fil: string; en: string }> = {
  core: { fil: 'Pangunahing impormasyon', en: 'Essentials' },
  transport: { fil: 'Pagpunta', en: 'Getting there' },
  food: { fil: 'Pagkain', en: 'Food & drink' },
  nearby: { fil: 'Mga malapit', en: 'Nearby' },
  itinerary: { fil: 'Ruta', en: 'Itineraries' },
  seasonal: { fil: 'Panahon', en: 'Seasons' },
  faq: { fil: 'FAQ', en: 'FAQ' },
};
const gl = groupLabels[topic.group];

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Gabay', item: homeUrl },
    { '@type': 'ListItem', position: 2, name: topic.h1En, item: pageUrl }
  ]
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: topic.faqs.map((faq) => ({
    '@type': 'Question',
    name: `${faq.qEn} / ${faq.qFil}`,
    acceptedAnswer: {
      '@type': 'Answer',
      text: `${faq.aEn} ${faq.aFil}`
    }
  }))
};
---

<Base title={topic.titleEn} description={topic.descEn}>
  <script type="application/ld+json" slot="structured-data" set:html={JSON.stringify(breadcrumbLd)} />
  <script type="application/ld+json" slot="structured-data" set:html={JSON.stringify(faqLd)} />

  <Breadcrumbs
    items={[
      { fil: 'Gabay', en: 'Guide', href: '/' },
      { fil: topic.h1Fil, en: topic.h1En, href: pageUrl }
    ]}
  />

  <section class="bg-[#17372c] px-5 py-16 text-white lg:px-10 lg:py-24">
    <div class="mx-auto max-w-[1440px]">
      <p class="text-xs font-black uppercase tracking-[0.24em] text-[#dcb17c]">
        <span class="lang-fil">{gl.fil}</span><span class="lang-en">{gl.en}</span>
      </p>
      <h1 class="mt-4 text-5xl font-bold leading-none md:text-6xl">
        <span class="lang-fil">{topic.h1Fil}</span><span class="lang-en">{topic.h1En}</span>
      </h1>
      <p class="mt-6 max-w-2xl text-base leading-7 text-white/80">
        <span class="lang-fil">{topic.introFil}</span><span class="lang-en">{topic.introEn}</span>
      </p>
      <MapsRating />
    </div>
  </section>

  <div class="ridge-line" aria-hidden="true"></div>

  <section class="mx-auto max-w-[1440px] px-5 py-16 lg:px-10 lg:py-24">
    <div class="grid gap-12">
      {
        topic.sections.map((s) => (
          <div>
            <h2 class="text-3xl font-bold text-[#17372c] md:text-4xl">
              <span class="lang-fil">{s.hFil}</span><span class="lang-en">{s.hEn}</span>
            </h2>
            <p class="mt-4 max-w-3xl text-base leading-7 text-[#5b625a]">
              <span class="lang-fil">{s.bFil}</span><span class="lang-en">{s.bEn}</span>
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-[#efe8da] py-16 lg:py-24">
    <div class="mx-auto max-w-[1440px] px-5 lg:px-10">
      <h2 class="text-3xl font-bold text-[#17372c] md:text-4xl">
        <span class="lang-fil">Mga sagot</span><span class="lang-en">Questions &amp; answers</span>
      </h2>
      <div class="mt-8 border-t border-[#17372c]/20">
        {
          topic.faqs.map((faq) => (
            <details class="faq-item group border-b border-[#17372c]/20 py-1">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-left text-xl font-bold text-[#17372c] marker:hidden md:text-2xl">
                <span>
                  <span class="lang-fil">{faq.qFil}</span><span class="lang-en">{faq.qEn}</span>
                </span>
                <span class="faq-plus shrink-0 text-3xl font-light text-[#a85f3d] transition-transform">+</span>
              </summary>
              <p class="max-w-3xl pb-7 pr-10 text-sm leading-7 text-[#596158]">
                <span class="lang-fil">{faq.aFil}</span><span class="lang-en">{faq.aEn}</span>
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1440px] px-5 py-16 lg:px-10 lg:py-24">
    <h2 class="text-3xl font-bold text-[#17372c] md:text-4xl">
      <span class="lang-fil">Mga kaugnay na gabay</span><span class="lang-en">Related guides</span>
    </h2>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        topic.related.map((slug) => {
          const rel = topics[slug];
          return rel ? (
            <a href={`/${slug}/`} class="stone-texture stone-edge block p-6 transition hover:shadow-xl">
              <h3 class="font-serif text-2xl font-bold text-[#17372c]">
                <span class="lang-fil">{rel.h1Fil}</span><span class="lang-en">{rel.h1En}</span>
              </h3>
              <p class="mt-3 text-sm leading-6 text-[#5b625a]">
                <span class="lang-fil">{rel.descFil}</span><span class="lang-en">{rel.descEn}</span>
              </p>
            </a>
          ) : null;
        })
      }
    </div>
  </section>
</Base>
